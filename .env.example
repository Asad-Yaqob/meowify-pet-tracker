# Firebase Configuration (Client-side — safe to expose, used by browser SDK)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration (Client-side — unsigned upload preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional App Base URL for development preview (defaults to current window origin)
VITE_APP_BASE_URL=

# ─── SERVER-SIDE ONLY (Vercel Serverless Functions) ───────────────────
# These are NEVER exposed to the browser. Set these in Vercel Dashboard > Settings > Environment Variables.

# Firebase Admin SDK (generate from Firebase Console > Project Settings > Service Accounts > Generate New Private Key)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Resend Email Service (get API key from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Meowify <notifications@meowify.pk>
